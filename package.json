{
  "name": "crimson-moon-rpg",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve-static.mjs",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "npx playwright test e2e/bootstrap_resilience.test.js e2e/character_creation.test.js e2e/load_game.test.js",
    "test:e2e:full": "npx playwright test",
    "test:e2e:smoke": "npm run test:e2e",
    "test:verify": "npm run lint && npm run check:narrative-state && npm run test:unit && npm run test:e2e",
    "check:narrative-state": "node scripts/check-narrative-state-registry.mjs",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "transform": {},
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  }
}
